          <mxGeometry x="980" y="60" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="expand" value="Expansion lowers the team size from 2 to 1" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=12;labelBackgroundColor=none;">
          <mxGeometry x="410" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="one" value="FlexMatch forms a one-player match" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=12;labelBackgroundColor=none;">
