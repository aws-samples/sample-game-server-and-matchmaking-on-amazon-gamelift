<?xml version="1.0" encoding="UTF-8"?>
<mxfile>
  <diagram id="diagram-1" name="Matchmaking flow">
    <mxGraphModel page="0" pageWidth="1260" pageHeight="360" pageScale="1" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Player presses Find match" vertex="1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;labelBackgroundColor=none;">
          <mxGeometry x="30" y="60" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ticket" value="StartMatchmaking: the ticket enters the pool" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;labelBackgroundColor=none;">
          <mxGeometry x="220" y="60" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wait" value="Second player in 15 s?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;labelBackgroundColor=none;">
          <mxGeometry x="400" y="45" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="two" value="FlexMatch forms a two-player match" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;labelBackgroundColor=none;">
          <mxGeometry x="600" y="60" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="The queue places the match on a ready process" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;labelBackgroundColor=none;">
          <mxGeometry x="790" y="60" width="130" height="60" as="geometry" />
