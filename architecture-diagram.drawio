        <mxCell id="ec2fleet" value="&lt;b&gt;Or: managed EC2 fleet&lt;/b&gt; (fleetType=ec2)&lt;br&gt;Game server on an EC2 instance the service runs&lt;br&gt;Players connect with wss://, only from allowedCidr" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#5A6C86;dashed=1;fontColor=#232F3E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;labelBackgroundColor=none;">
          <mxGeometry x="860" y="515" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Game server SDK calls, in order&lt;/b&gt;&lt;br&gt;1: InitSDK, ProcessReady&lt;br&gt;6: reads the match's players, ActivateGameSession&lt;br&gt;If only one player: the server plays the other seat&lt;br&gt;7: AcceptPlayerSession, then gameplay over WebSocket&lt;br&gt;After the match: RemovePlayerSession, ProcessEnding" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#BDC1C6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;labelBackgroundColor=none;">
          <mxGeometry x="900" y="50" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. Sign in" edge="1" parent="1" source="browser" target="cognito" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#232F3E;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry x="0.45" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. Find match, check ticket&#10;(address comes back in step 5)" edge="1" parent="1" source="browser" target="apigw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
