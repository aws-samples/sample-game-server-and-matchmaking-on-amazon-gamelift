          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. Start game session&#10;(over the step 1 connection)" edge="1" parent="1" source="queue" target="server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#ED7100;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
