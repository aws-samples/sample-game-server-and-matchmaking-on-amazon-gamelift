        <mxCell id="mm" value="FlexMatch matchmaker&#10;2 players, or 1 after 15 s" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=12;labelBackgroundColor=none;">
