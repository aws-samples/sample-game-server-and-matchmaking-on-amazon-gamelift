          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. StartMatchmaking" edge="1" parent="1" source="lambda" target="mm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
